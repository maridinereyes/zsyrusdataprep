{
  "_version": "1.76.0",
  "sap.app": {
    "id": "com.lvmh.apollo.zsyrusdataprepui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.1",
      "toolsId": "4ef5bc01-1a33-4693-99e7-3a30f422e471"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZFI_SYRUS_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZDDL_FI_GROUPACCOUNT_CDS_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZDDL_FI_GROUPACCOUNT_CDS_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/ZDDL_FI_GROUPACCOUNT_CDS/ZDDL_FI_GROUPACCOUNT_CDS_VAN.xml"
        }
      },
      "ZDDL_FI_GROUPACCOUNT_CDS": {
        "uri": "/sap/opu/odata/sap/ZDDL_FI_GROUPACCOUNT_CDS/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZDDL_FI_GROUPACCOUNT_CDS_VAN"
          ],
          "localUri": "localService/ZDDL_FI_GROUPACCOUNT_CDS/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSYRUS-create": {
          "semanticObject": "ZSYRUS",
          "action": "create",
          "title": "{{ZSYRUS-create.flpTitle}}",
          "subTitle": "{{ZSYRUS-create.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.141.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.lvmh.apollo.zsyrusdataprepui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "ZDDL_FI_GROUPACCOUNT_CDS": {
        "dataSource": "ZDDL_FI_GROUPACCOUNT_CDS",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "config": {
      "fullWidth": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.lvmh.apollo.zsyrusdataprepui.view",
        "async": true,
        "viewPath": "com.lvmh.apollo.zsyrusdataprepui.view"
      },
      "routes": [
        {
          "name": "RouteFilters",
          "pattern": ":?query:",
          "target": [
            "TargetFilters"
          ]
        }
      ],
      "targets": {
        "TargetFilters": {
          "id": "Filters",
          "name": "Filters"
        }
      }
    },
    "rootView": {
      "viewName": "com.lvmh.apollo.zsyrusdataprepui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "zsyrusdataprep"
  }
}
